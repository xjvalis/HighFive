{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Mu\u017e",
        "\u017dena",
        "Jin\u00e9",
        "Nechci uv\u00e1d\u011bt"
      ]
    },
    "favorite_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "joined_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "favorited_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "free",
        "plus",
        "creator"
      ],
      "default": "free"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "monthly_join_count": {
      "type": "number",
      "default": 0
    },
    "monthly_create_count": {
      "type": "number",
      "default": 0
    },
    "monthly_reset_date": {
      "type": "string",
      "format": "date"
    },
    "events_joined_this_week": {
      "type": "number",
      "default": 0
    },
    "events_created_this_week": {
      "type": "number",
      "default": 0
    },
    "week_reset_date": {
      "type": "string",
      "format": "date"
    },
    "reputation_score": {
      "type": "number",
      "default": 0
    },
    "notify_email_reminders": {
      "type": "boolean",
      "default": true
    },
    "notify_email_event_updates": {
      "type": "boolean",
      "default": true
    },
    "notify_email_new_participants": {
      "type": "boolean",
      "default": false
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "user_condition": {
        "role": {
          "$exists": true
        }
      }
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}