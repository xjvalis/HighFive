VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Optional — error monitoring, see https://sentry.io. App runs fine without it.
VITE_SENTRY_DSN=

# Optional — only needed to upload readable source maps to Sentry at build
# time (org/project settings, auth token is a secret — never commit a real
# value). Without these, the build just skips source map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional — geocoding + map tiles upgrade, see https://developer.mapy.cz.
# Without it the app falls back to Nominatim/OSM, which needs no key but is
# rate-limited and has thinner POI coverage in CZ.
VITE_MAPY_CZ_API_KEY=

# --- Supabase Edge Function secrets (NOT read from this file) ---
# Set these with `supabase secrets set NAME=value`, not in .env — they're
# used server-side by the notify-admins-email function, never shipped to
# the browser.
#   RESEND_API_KEY   — from https://resend.com. Without it, admin emails are
#                       skipped (in-app notifications still work).
#   NOTIFY_FROM_EMAIL — optional "Name <email@yourdomain.com>" sender; falls
#                        back to Resend's shared onboarding@resend.dev.
